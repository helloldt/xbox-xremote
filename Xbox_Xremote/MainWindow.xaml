<Window x:Class="Wpf_webxbox.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Wpf_webxbox"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="Xbox Remote Play" Height="900" Width="1500"
        Background="White"
        WindowStartupLocation="CenterScreen">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" BorderBrush="#F0F0F0" BorderThickness="0,0,0,1" Padding="20,0" Background="White">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                
                <!-- Logo / Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Xbox" FontSize="20" FontWeight="Bold" Foreground="#107C10" VerticalAlignment="Center"/>
                    <TextBlock Text=" Remote Play" FontSize="20" FontWeight="Normal" Foreground="#333333" VerticalAlignment="Center"/>
                </StackPanel>
                
                <!-- Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Navigation -->
                 
                    <Button x:Name="XboxButton" Content="Xbox Gaming" Style="{StaticResource PrimaryButtonStyle}" Width="120" Height="36" Click="XboxButton_Click" Margin="0,0,10,0"/>
                    
                    <Separator Style="{StaticResource {x:Static ToolBar.SeparatorStyleKey}}" Margin="10,0"/>
                    
                    <Button x:Name="GamepadButton" Content="🎮" Width="46" Height="36" Click="GamepadButton_Click" ToolTip="启用/禁用虚拟手柄" Margin="0,0,8,0"/>
                    <Button x:Name="KeyMapButton" Content="⌨" Width="46" Height="36" Click="KeyMapButton_Click" ToolTip="按键映射" Margin="0,0,8,0"/>
                    <Button x:Name="RefreshButton" Content="⟳" Width="46" Height="36" Click="RefreshButton_Click" ToolTip="刷新" Margin="0,0,8,0"/>
                    <Button x:Name="SettingsButton" Content="⚙" Width="46" Height="36" Click="SettingsButton_Click" ToolTip="设置" Margin="0,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>
        
        <!-- Main Content -->
        <Grid Grid.Row="1" Background="#F9F9F9">
            <wv2:WebView2 x:Name="webView" 
                          NavigationStarting="WebView_NavigationStarting"
                          NavigationCompleted="WebView_NavigationCompleted"/>
        </Grid>
        
        <!-- Footer -->
        <Border Grid.Row="2" Background="White" BorderBrush="#F0F0F0" BorderThickness="0,1,0,0" Padding="15,0">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusText" Text="就绪" Foreground="#888888" FontSize="12"/>
                    <TextBlock x:Name="GamepadStatus" Text="" Foreground="#107C10" Margin="20,0,0,0" FontSize="12" FontWeight="SemiBold"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
